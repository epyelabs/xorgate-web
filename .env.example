VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_API_BASE_URL=
# Live telemetry (P2): Cognito Identity Pool creds + AWS IoT MQTT-over-WSS
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_AWS_REGION=us-east-1
# iot:Data-ATS endpoint, e.g. xxxxxxxx-ats.iot.us-east-1.amazonaws.com
# (the `iot.dataEndpoint` from a POST /devices/{id}/provision response)
VITE_IOT_ENDPOINT=
# Mapbox public access token (pk.*) for the Active Streams "Map View" basemap.
VITE_MAPBOX_TOKEN=
