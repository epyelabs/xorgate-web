VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Cognito Hosted-UI base URL for Google sign-in (the HostedUiBaseUrl output of
# XorgateCoreAuthStack), e.g. https://xorgate-authdev.auth.us-east-1.amazoncognito.com
# Leave blank to hide the Google button. The callback (/auth/callback) and
# logout (/login) URLs are derived from the page origin.
VITE_COGNITO_DOMAIN=
VITE_API_BASE_URL=
# Live telemetry (P2): Cognito Identity Pool creds + AWS IoT MQTT-over-WSS
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_AWS_REGION=us-east-1
# iot:Data-ATS endpoint, e.g. xxxxxxxx-ats.iot.us-east-1.amazonaws.com
# (the `iot.dataEndpoint` from a POST /devices/{id}/provision response)
VITE_IOT_ENDPOINT=
